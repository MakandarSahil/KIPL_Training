## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build results
bin/
obj/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / JetBrains IDE
.idea/

# VS Code settings
.vscode/

# Auto-generated by dotnet
*.dbmdl
*.bak

# NuGet packages
*.nupkg
*.snupkg
packages/
*.nuget.props
*.nuget.targets

# Logs
*.log
logs/
log/

# Temporary files
*.tmp
*.temp

# dotenv files (if you use them later)
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# JSON data in your app (optional)
# If you want to keep your accounts/transactions out of Git, uncomment below:
# data/accounts.json
# data/transactions.json

# Application secrets (if any)
secrets.json
appsettings.Development.json

# Build artifacts
*.exe
*.dll
*.pdb

# Test results
TestResults/
coverage/
*.coverage

# Publish folder
publish/

@page "/"

<PageTitle>KIPL Machine Management System</PageTitle>

<h1>This is KIPL Machine Management Platform!</h1>

KIPL Machine Management Platform!

<SurveyPrompt Title="This platfrom give assets name by machine name , machines name by asset name and machine with latest series" />

<div class="container py-2 px-2 m-2">
    <div class="row g-4">

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="fw-bold">All Machines</h5>
                    <p class="text-muted">
                        View All Machines.
                    </p>
                    <a href="/assets-by-machine" class="btn btn-primary">
                        View All
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Assets by Machine</h5>
                    <p class="text-muted">
                        View assets used by a specific machine.
                    </p>
                    <a href="/assets-by-machine" class="btn btn-primary">
                        Search Assets
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Machines by Asset</h5>
                    <p class="text-muted">
                        Find machines using a selected asset.
                    </p>
                    <a href="/machines-by-asset" class="btn btn-primary">
                        Search Machines
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="fw-bold">Latest Asset Series</h5>
                    <p class="text-muted">
                        Machines using the latest asset series.
                    </p>
                    <a href="/latest-series" class="btn btn-primary">
                        View Machines
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@page "/"
@page "/all-machines"
@using KlingelnbergMachineManagement.Services
@using KlingelnbergMachineManagement.Application.Services
@using KlingelnbergMachineManagement.Application.DTOs
@inject IMachineService Service

<PageTitle>All Machine Details</PageTitle>

<div class="container-fluid py-4">
    <!-- Loading State -->
    <h4 class="">All Machines </h4>
    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading machines...</p>
        </div>
    }
    else if (machines != null && machines.Any())
    {
        <!-- Machines Table -->
        <p>Total (@machines.Count()) / Update needed (@machines.Count(m => !m.UsesLatestSeries)) / Latest (@machines.Count(m => m.UsesLatestSeries))</p>
        <div class="table-responsive">
            <table class="table table-bordered mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Machine</th>
                        <th>Assets</th>
                        <th class="pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var machine in machines)
                    {
                        <tr>
                            <td class="ps-4 align-middle">
                                <div class="d-flex align-items-center">
                                    <div>
                                        <div class="fw-medium">@machine.MachineType</div>
                                        <small class="text-muted">@machine.Assets.Count assets</small>
                                    </div>
                                </div>
                            </td>
                            <td class="align-middle">
                                <div class="d-flex flex-wrap gap-4">
                                    @foreach (var asset in machine.Assets)
                                    {
                                        <p class="">
                                            @asset.AssetName:
                                            <span class="fw-medium">@asset.SeriesNumber</span>
                                            @if (!asset.IsLatestSeries)
                                            {
                                                <i class="bi bi-exclamation-circle text-warning ms-1"></i>
                                            }
            ,
                                        </p>
                                    }
                                </div>
                            </td>
                            <td class="pe-4 align-middle">
                                @if (machine.UsesLatestSeries)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Latest
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 px-3 py-1">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Update Available
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    } else if (!string.IsNullOrEmpty(err)) 
    {
        <div class="text-center py-5">
            <i class="bi bi-cpu display-1 text-muted"></i>
            <h5 class="mt-3">Error Occured !!</h5>
            <p class="mb-4 text-danger">@err.</p>
        </div>
    }
    else if (!isLoading)
    {
        <!-- Empty State -->
        <div class="text-center py-5">
            <i class="bi bi-cpu display-1 text-muted"></i>
            <h5 class="mt-3">No Machines Found</h5>
            <p class="text-muted mb-4">No machine data is available to display.</p>
        </div>
    }
</div>

@code {
    private IEnumerable<MachineDetailDto>? machines;
    private bool isLoading = true;
    private string err = String.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            machines = await Service.GetAllMachineDetailsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading machine details: {ex.Message}");
            err = ex.Message;

        }
        finally
        {
            isLoading = false;
        }
    }
}
@page "/all-machines"
@using KlingelnbergMachineManagement.Services
@using KlingelnbergMachineManagement.Application.Services
@using KlingelnbergMachineManagement.Application.DTOs
@inject IMachineService Service

<PageTitle>All Machine Details</PageTitle>

<div class="container mt-4">
    <h2>📊 Comprehensive Machine Asset Report</h2>
    <p class="text-muted">Detailed view of all machines and their asset configurations.</p>

    @if (isLoading)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading machine details...</p>
        </div>
    }
    else if (machines != null && machines.Any())
    {
        <div class="card bg-light mb-4">
            <div class="card-body">
                <h5>📈 Summary Statistics</h5>
                <div class="row text-center">
                    <div class="col-md-4">
                        @* <h3 class="text-primary">@machines.Count</h3> *@
                        <p class="text-muted">Total Machines</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="text-success">@machines.Count(m => m.UsesLatestSeries)</h3>
                        <p class="text-muted">Fully Updated</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="text-warning">@machines.Count(m => !m.UsesLatestSeries)</h3>
                        <p class="text-muted">Need Updates</p>
                    </div>
                </div>
            </div>
        </div>

        @foreach (var machine in machines)
        {
            <div class="card mb-4 @(machine.UsesLatestSeries ? "border-success" : "border-warning")">
                <div class="card-header @(machine.UsesLatestSeries ? "bg-success" : "bg-warning") text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-cpu-fill"></i> @machine.MachineType
                        </h5>
                        @if (machine.UsesLatestSeries)
                        {
                            <span class="badge bg-light text-success">
                                <i class="bi bi-check-circle-fill"></i> Latest Series
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-light text-warning">
                                <i class="bi bi-exclamation-circle-fill"></i> Outdated Assets
                            </span>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th><i class="bi bi-gear"></i> Asset Name</th>
                                    <th><i class="bi bi-hash"></i> Series Number</th>
                                    <th><i class="bi bi-info-circle"></i> Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var asset in machine.Assets)
                                {
                                    <tr class="@(asset.IsLatestSeries ? "" : "table-warning")">
                                        <td>
                                            <i class="bi bi-gear-fill text-primary"></i>
                                            @asset.AssetName
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary">@asset.SeriesNumber</span>
                                        </td>
                                        <td>
                                            @if (asset.IsLatestSeries)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-lg"></i> Latest
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">
                                                    <i class="bi bi-arrow-up-circle"></i> Update Available
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mt-2">
                        <small class="text-muted">Total Assets: @machine.Assets.Count</small>
                    </div>
                </div>
            </div>
        }
    }
    else if (!isLoading)
    {
        <div class="alert alert-warning" role="alert">
            No machine data available.
        </div>
    }

    <div class="mt-3">
        <a href="/" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
    </div>
</div>

@code {
    private IEnumerable<MachineDetailDto>? machines;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            machines = await Service.GetAllMachineDetailsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading machine details: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
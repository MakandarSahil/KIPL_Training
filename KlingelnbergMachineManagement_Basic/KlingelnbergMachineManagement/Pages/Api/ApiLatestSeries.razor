@page "/api/latest-series"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Latest Series Machines (API)</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>⭐ Machines Using Latest Series</h2>
        <span class="badge bg-success">API Access</span>
    </div>

    <p class="text-muted">
        These machines are using the latest series of ALL their assets.
        Data retrieved via REST API.
    </p>

    @if (!string.IsNullOrEmpty(apiEndpoint))
    {
        <div class="alert alert-secondary">
            <small><strong>API Endpoint:</strong> <code>@apiEndpoint</code></small>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Calling API to analyze machine configurations...</p>
        </div>
    }
    else if (machines != null && machines.Any())
    {
        <div class="card mt-4 border-success">
            <div class="card-header bg-success text-white">
                <h5>
                    <i class="bi bi-check-circle-fill"></i>
                    Machines with Latest Series (@machines.Count)
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var machine in machines)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="card border-success h-100">
                                <div class="card-body text-center">
                                    <i class="bi bi-cpu-fill text-success" style="font-size: 3rem;"></i>
                                    <h5 class="card-title mt-2">@machine</h5>
                                    <span class="badge bg-success">Fully Updated</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                @if (loadTime.HasValue)
                {
                    <div class="mt-3">
                        <span class="badge bg-secondary">API Call Time: @loadTime.Value ms</span>
                    </div>
                }
            </div>
        </div>

        <div class="alert alert-info mt-4" role="alert">
            <i class="bi bi-info-circle-fill"></i>
            <strong>Note:</strong> These machines use the highest series number for each of their assets,
            ensuring optimal performance with the latest components.
        </div>
    }
    else if (!isLoading && machines != null)
    {
        <div class="alert alert-warning mt-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            No machines are currently using the latest series of all their assets.
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-4" role="alert">
            <i class="bi bi-x-circle"></i> @errorMessage
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
        <a href="/direct/latest-series" class="btn btn-outline-primary ms-2">
            <i class="bi bi-arrow-right"></i> Try Direct Version
        </a>
        <a href="/all-machines" class="btn btn-info ms-2">
            <i class="bi bi-table"></i> View Details
        </a>
    </div>
</div>

@code {
    private List<string>? machines;
    private bool isLoading = true;
    private long? loadTime;
    private string? errorMessage;
    private string? apiEndpoint;

    protected override async Task OnInitializedAsync()
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var baseUrl = Navigation.BaseUri;
            apiEndpoint = $"GET {baseUrl}api/machineasset/machines/latest-series";
            machines = await Http.GetFromJsonAsync<List<string>>($"{baseUrl}api/machineasset/machines/latest-series");
            sw.Stop();
            loadTime = sw.ElapsedMilliseconds;
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"API Error: {ex.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
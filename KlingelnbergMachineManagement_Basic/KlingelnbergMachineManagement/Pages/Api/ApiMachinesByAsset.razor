@page "/api/machines-by-asset"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Machines by Asset (API)</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h4>Find Machines by Asset Name</h4>
        <span class="badge bg-primary">API Access</span>
    </div>

    

    @if (isLoading)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Calling API...</p>
        </div>
    }
    else if (allAssets != null && allAssets.Any())
    {
        <p class="text-muted">Select an asset to view all machines that use it. Data retrieved via REST API.</p>

        <div class="card mt-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label"><strong>Select Asset Name:</strong></label>
                        <select class="form-select" @bind="selectedAsset">
                            <option value="">-- Select an Asset --</option>
                            @foreach (var asset in allAssets)
                            {
                                <option value="@asset">@asset</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button class="btn btn-success" @onclick="SearchMachines" disabled="@string.IsNullOrEmpty(selectedAsset)">
                            <i class="bi bi-search"></i> Search via API
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(apiEndpoint))
                {
                    <div class="mt-3">
                        <small class="text-muted">
                            <strong>API Endpoint:</strong> <code>@apiEndpoint</code>
                        </small>
                    </div>
                }
            </div>
        </div>
    } else if(!string.IsNullOrEmpty(err))
    {
        <div class="text-center py-5">
            <i class="bi bi-cpu display-1 text-muted"></i>
            <h5 class="mt-3">Error Occured !!</h5>
            <p class="mb-4 text-danger">@err.</p>
        </div>
    }
    else if (machines != null && machines.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5><i class="bi bi-cpu-fill"></i> Machines Using "@selectedAsset"</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var machine in machines)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> @machine
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else if (searchPerformed && (machines == null || !machines.Any()))
    {
        <div class="alert alert-warning mt-4" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            No machines found using asset <strong>@selectedAsset</strong>.
        </div>
    }

    @* @if (!string.IsNullOrEmpty(err))
    {
        <div class="alert alert-danger mt-4" role="alert">
            <i class="bi bi-x-circle"></i> @err
        </div>
    } *@

    <div class="mt-4">
        <a href="/" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
        <a href="/direct/machines-by-asset" class="btn btn-outline-primary ms-2">
            <i class="bi bi-arrow-right"></i> Try Direct Version
        </a>
    </div>
</div>

@code {
    private List<string> allAssets = new();
    private string selectedAsset = string.Empty;
    private List<string>? machines;
    private bool isLoading = false;
    private bool searchPerformed = false;
    private long? loadTime;
    private string? err;
    private string? apiEndpoint;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var baseUrl = Navigation.BaseUri;
            allAssets = await Http.GetFromJsonAsync<List<string>>($"{baseUrl}api/machineasset/assets") ?? new();
        }
        catch (Exception ex)
        {
            err = $"Error loading assets: {ex.Message}";
        }
    }

    private async Task SearchMachines()
    {
        if (string.IsNullOrWhiteSpace(selectedAsset))
            return;

        isLoading = true;
        searchPerformed = true;
        err = null;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        try
        {
            var baseUrl = Navigation.BaseUri;
            apiEndpoint = $"GET {baseUrl}api/machineasset/assets/{selectedAsset}/machines";
            machines = await Http.GetFromJsonAsync<List<string>>($"{baseUrl}api/machineasset/assets/{selectedAsset}/machines");
            sw.Stop();
            loadTime = sw.ElapsedMilliseconds;
        }
        catch (HttpRequestException ex)
        {
            err = $"API Error: {ex.Message}";
            machines = new List<string>();
        }
        catch (Exception ex)
        {
            err = $"Error: {ex.Message}";
            machines = new List<string>();
        }
        finally
        {
            isLoading = false;
        }
    }
}
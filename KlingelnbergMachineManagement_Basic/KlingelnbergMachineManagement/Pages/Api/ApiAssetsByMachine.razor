@page "/api/assets-by-machine"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>Assets by Machine (API)</PageTitle>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h4>Find Assets by Machine Type</h4>
        <span class="badge bg-primary">API Access</span>
    </div>
    @if (!string.IsNullOrEmpty(apiEndpoint))
    {
        <div class="mt-3">
            <small class="text-muted">
                <strong>API Endpoint:</strong> <code>@apiEndpoint</code>
            </small>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center mt-4">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Calling API...</p>
        </div>
    } else if (allMachines != null && allMachines.Any())
    {
        <p class="text-muted">Select a machine type to view all assets it uses. Data retrieved via REST API.</p>
        <div class="card mt-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <label class="form-label"><strong>Select Machine Type:</strong></label>
                        <select class="form-select" @bind="selectedMachine">
                            <option value="">-- Select a Machine --</option>
                            @foreach (var machine in allMachines)
                            {
                                <option value="@machine">@machine</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 d-flex align-items-end">
                        <button class="btn btn-success" @onclick="SearchAssets" disabled="@string.IsNullOrEmpty(selectedMachine)">
                            <i class="bi bi-search"></i> Search via API
                        </button>
                    </div>
                </div>
            </div>
        </div>
    } else if (!string.IsNullOrEmpty(err))
    {
        <div class="text-center py-5">
            <i class="bi bi-cpu display-1 text-muted"></i>
            <h5 class="mt-3">Error Occured !!</h5>
            <p class="mb-4 text-danger">@err.</p>
        </div>
    }
    else if (assets != null && assets.Any())
    {
        <div class="card mt-4">
            <div class="card-header">
                <h5><i class="bi bi-gear-fill"></i> Assets Used by @selectedMachine</h5>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush">
                    @foreach (var asset in assets)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-check-circle text-success"></i> @asset
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
    else if (searchPerformed && (assets == null || !assets.Any()))
    {
        <div class="alert alert-warning mt-4" role="alert">
            <i class="bi bi-exclamation-triangle"></i>
            No assets found for machine type <strong>@selectedMachine</strong>.
        </div>
    }

    @* @if (!string.IsNullOrEmpty(err))
    {
        <div class="alert alert-danger mt-4" role="alert">
            <i class="bi bi-x-circle"></i> @err
        </div>
    } *@

    <div class="mt-4">
        <a href="/" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Home
        </a>
        <a href="/direct/assets-by-machine" class="btn btn-outline-primary ms-2">
            <i class="bi bi-arrow-right"></i> Try Direct Version
        </a>
    </div>
</div>

@code {
    private List<string> allMachines = new();
    private string selectedMachine = string.Empty;
    private List<string>? assets;
    private bool isLoading = false;
    private bool searchPerformed = false;
    private string? err;
    private string? apiEndpoint;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var baseUrl = Navigation.BaseUri;
            allMachines = await Http.GetFromJsonAsync<List<string>>($"{baseUrl}api/machineasset/machines") ?? new();
        }
        catch (Exception ex)
        {
            err = $"Error loading machines: {ex.Message}";
        }
    }

    private async Task SearchAssets()
    {
        if (string.IsNullOrWhiteSpace(selectedMachine))
            return;

        isLoading = true;
        searchPerformed = true;
        err = null;

        try
        {
            var baseUrl = Navigation.BaseUri;
            apiEndpoint = $"GET {baseUrl}api/machineasset/machine/{selectedMachine}/assets";
            assets = await Http.GetFromJsonAsync<List<string>>(
                $"{baseUrl}api/machineasset/machine/{selectedMachine}/assets");
        }
        catch (HttpRequestException ex)
        {
            err = $"API Error: {ex.Message}";
            assets = new List<string>();
        }
        catch (Exception ex)
        {
            err = $"Error: {ex.Message}";
            assets = new List<string>();
        }
        finally
        {
            isLoading = false;
        }
    }
}